# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for server-verified owner login and protected work-photo uploads.
# Use a unique secret of at least 12 characters; do not commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OWNER_PASSCODE="YOUR_UNIQUE_OWNER_PASSCODE_MIN_12_CHARS"

# Supabase backend (PostgreSQL + Storage). Get these from your Supabase project:
# Project Settings -> Data API (URL + anon key) and API Keys (service_role secret).
# WARNING: the service_role key bypasses Row Level Security. Server-side only -
# never expose it to the browser (never prefix it with VITE_). Set it in Vercel
# environment variables, not in any committed file.
SUPABASE_URL="https://wovlulxevzgwnoujeeqv.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET"

# APP_URL: The public URL where this portfolio is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://robertopokudanso.online"
